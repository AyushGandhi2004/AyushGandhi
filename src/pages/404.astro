---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Ayush Gandhi" description="This page doesn't exist.">
  <section class="wrap flex min-h-[70vh] flex-col justify-center py-20">
    <span class="label">(404)</span>
    <h1 class="mt-6 font-display text-[clamp(5rem,22vw,20rem)] font-bold leading-[0.82] tracking-[-0.06em]">
      Lost<span class="text-muted">.</span>
    </h1>
    <p class="mt-8 max-w-md text-xl text-muted">This page doesn't exist — maybe it never did.</p>
    <a href="/" class="btn btn-solid mt-8 self-start">Back home <span aria-hidden="true">→</span></a>
  </section>
</Base>
