---
import { Picture } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import portrait from '../assets/portrait.jpg';
import { about } from '../config/site';
---

<section id="about" class="wrap py-20 md:py-32" aria-labelledby="about-title">
  <SectionHeader index="02" id="about-title" title="About" />

  <div class="grid-12 mt-12 gap-y-10 md:mt-16">
    <div class="reveal col-span-4 md:col-span-4">
      <Picture
        src={portrait}
        alt="Portrait of Ayush Gandhi"
        formats={['avif', 'webp']}
        widths={[360, 560, 800]}
        sizes="(min-width: 768px) 30vw, 92vw"
        class="aspect-[4/5] w-full rounded-2xl object-cover"
      />
    </div>

    <div class="col-span-4 md:col-span-7 md:col-start-6">
      <div class="space-y-6 text-xl leading-relaxed md:text-2xl md:leading-snug">
        {about.paragraphs.map((p, i) => <p class:list={['reveal', i > 0 && 'text-muted']}>{p}</p>)}
      </div>

      <dl class="mt-12 border-t border-ink">
        {about.currently.map((row) => (
          <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-line py-4 md:grid-cols-[10rem_1fr]">
            <dt class="label pt-1">{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
