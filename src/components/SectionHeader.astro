---
interface Props {
  index: string;
  title: string;
  id: string;
  aside?: string;
}
const { index, title, id, aside } = Astro.props;
---

<div class="grid-12 items-end border-t-2 border-ink pt-4">
  <span class="label col-span-1 md:col-span-2">({index})</span>
  <h2 id={id} class="col-span-3 font-display text-[clamp(2.5rem,6vw,5.5rem)] font-bold leading-[0.9] tracking-[-0.045em] md:col-span-7">
    {title}
  </h2>
  {aside && <p class="col-span-4 mt-4 max-w-sm text-muted md:col-span-3 md:mt-0 md:text-right">{aside}</p>}
</div>
